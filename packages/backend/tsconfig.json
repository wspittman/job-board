{
  "extends": "../../tsconfig.server.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",

    // To get the .cjs workaround for Application Insights
    "allowSyntheticDefaultImports": true,
    "allowJs": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
