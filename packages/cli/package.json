{
  "name": "cli",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier . --write",
    "test": "node --test --import ./test/setup.ts --env-file=./test/.env.test --test-reporter=dot test/**/*.test.ts",
    "test-details": "node --import ./test/setup.ts --env-file=./test/.env.test --test test/**/*.test.ts",
    "cli": "node --env-file=.env src/index.ts"
  },
  "dependencies": {
    "dry-utils-async": "^0.3.2",
    "dry-utils-openai": "^0.4.2",
    "dry-utils-text": "^0.2.1",
    "ml-kmeans": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.0.0",
    "prettier": "^3.7.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.56.0"
  }
}
